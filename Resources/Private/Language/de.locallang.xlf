<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.0">
	<file source-language="en" target-language="de" product-name="typo3-image-compression">
		<header/>
		<body>
			<trans-unit id="label">
				<source/>
				<target>Bildkomprimierung</target>
			</trans-unit>
			<trans-unit id="compressingLabel">
				<source/>
				<target>Bild wird komprimiert...</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.folderExcluded">
				<source/>
				<target>Ordner von Komprimierung ausgeschlossen ("%s")</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.debugMode">
				<source/>
				<target>Läuft im Debug-Modus, keine Komprimierung</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.compressionFailed">
				<source/>
				<target>Komprimierung fehlgeschlagen mit Meldung "%s"</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.success">
				<source/>
				<target>Die Bildkomprimierung hat Ihnen etwa %s Ihrer Dateigröße eingespart.</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.alreadyOptimal">
				<source/>
				<target>Bild ist bereits optimal komprimiert, Original wurde beibehalten.</target>
			</trans-unit>
			<trans-unit id="flashMessage.title">
				<source/>
				<target>Komprimierung</target>
			</trans-unit>
			<trans-unit id="apiKey">
				<source/>
				<target>API-Schlüssel: Bitte geben Sie Ihren Tinyfy API-Schlüssel ein</target>
			</trans-unit>
			<trans-unit id="debug">
				<source/>
				<target>Debug-Modus aktivieren oder deaktivieren. Verhindert, dass die Erweiterung Bilder komprimiert. Im Entwicklungsmodus verwenden, um Komprimierungen zu sparen.</target>
			</trans-unit>
			<trans-unit id="excludeFolders">
				<source/>
				<target>Kommagetrennte Liste von Ordnern, die von der Komprimierung ausgeschlossen werden sollen. Relativ zum Speicher (z.B. fileadmin), beginnend mit "/" (z.B. "/user_upload,/folder_under_fileadmin")</target>
			</trans-unit>
			<trans-unit id="mimeTypes">
				<source/>
				<target>Kommagetrennte Liste von zugelassenen Bildtypen.</target>
			</trans-unit>
			<trans-unit id="systemInformationToolbar">
				<source/>
				<target>Zeige das Bildkomprimierungslimit in der Systeminformationstoolbar an.</target>
			</trans-unit>
			<trans-unit id="showCompressionStatus">
				<source/>
				<target>Zeige den Komprimierungsstatus im Datei-Metadaten-Formular an.</target>
			</trans-unit>
			<trans-unit id="showStatusReport">
				<source/>
				<target>Zeige Komprimierungsstatistik im Systemberichte-Modul an.</target>
			</trans-unit>
			<trans-unit id="enableBackup">
				<source/>
				<target>Originaldateien sichern: Behält vor der Komprimierung eine Kopie der Originaldatei, damit sie später wiederhergestellt werden kann.</target>
			</trans-unit>
			<trans-unit id="backupRetentionDays">
				<source/>
				<target>Backup-Aufbewahrung (Tage): Backups, die älter sind, werden vom Befehl "imagecompression:pruneBackups" entfernt. 0 bewahrt Backups unbegrenzt auf.</target>
			</trans-unit>
			<trans-unit id="restoreAction">
				<source/>
				<target>Originaldatei wiederherstellen</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.restoreSuccess">
				<source/>
				<target>Originaldatei aus Backup wiederhergestellt.</target>
			</trans-unit>
			<trans-unit id="flashMessage.message.restoreFailed">
				<source/>
				<target>Wiederherstellung der Originaldatei fehlgeschlagen. Es wurde kein gültiges Backup gefunden.</target>
			</trans-unit>
			<trans-unit id="preserveCopyright">
				<source/>
				<target>Copyright-Metadaten erhalten: Behält das EXIF/IPTC-Copyright-Tag bei der Komprimierung bei, statt es zu entfernen.</target>
			</trans-unit>
			<trans-unit id="preserveCreationDate">
				<source/>
				<target>Erstellungsdatum erhalten: Behält das EXIF/IPTC-Erstellungsdatum bei der Komprimierung bei, statt es zu entfernen.</target>
			</trans-unit>
			<trans-unit id="preserveColorProfile">
				<source/>
				<target>Farbprofil erhalten: Behält das eingebettete ICC-Farbprofil bei der Komprimierung bei, statt es zu entfernen.</target>
			</trans-unit>
			<trans-unit id="provider">
				<source/>
				<target>Komprimierungsanbieter: tinify = TinyPNG API, local-tools = jpegoptim/optipng/etc., local-basic = ImageMagick/GraphicsMagick. Kommagetrennt für eine Fallback-Reihenfolge, z. B. weicht "tinify,local-tools" auf local-tools aus, sobald das Kontingent von tinify aufgebraucht ist oder für einen von tinify nicht unterstützten MIME-Typ.</target>
			</trans-unit>
			<trans-unit id="jpegQuality">
				<source/>
				<target>JPEG-Qualität (1-100): Qualitätseinstellung für lokale JPEG-Komprimierung</target>
			</trans-unit>
			<trans-unit id="pngQuality">
				<source/>
				<target>PNG-Qualität (1-100): Qualitätseinstellung für lokale PNG-Komprimierung (pngquant)</target>
			</trans-unit>
			<trans-unit id="webpQuality">
				<source/>
				<target>WebP-Qualität (1-100): Qualitätseinstellung für lokale WebP-Komprimierung</target>
			</trans-unit>
			<trans-unit id="commandTimeout">
				<source/>
				<target>Befehls-Timeout (Sekunden): Timeout für externe Tool-Aufrufe (local-tools/local-basic Provider)</target>
			</trans-unit>
			<trans-unit id="minimumSavingPercent">
				<source/>
				<target>Mindesteinsparung (%, 0-100): Das komprimierte Ergebnis muss mindestens so viel kleiner sein als das Original, um übernommen zu werden. Darunter bleibt die Originaldatei erhalten.</target>
			</trans-unit>
			<trans-unit id="tab.compression">
				<source/>
				<target>Komprimierung</target>
			</trans-unit>
			<trans-unit id="field.compression_info">
				<source/>
				<target>Komprimierungsstatus</target>
			</trans-unit>
			<trans-unit id="status.compressed">
				<source/>
				<target>Komprimiert</target>
			</trans-unit>
			<trans-unit id="status.not_compressed">
				<source/>
				<target>Nicht komprimiert</target>
			</trans-unit>
			<trans-unit id="status.optimal">
				<source/>
				<target>Bereits optimal</target>
			</trans-unit>
			<trans-unit id="status.error">
				<source/>
				<target>Fehler</target>
			</trans-unit>
			<trans-unit id="status.no_file">
				<source/>
				<target>Keine Datei zugeordnet</target>
			</trans-unit>
			<trans-unit id="status.file_not_found">
				<source/>
				<target>Datei nicht gefunden</target>
			</trans-unit>
			<trans-unit id="report.provider">
				<source/>
				<target>Anbieter</target>
			</trans-unit>
			<trans-unit id="report.provider.description">
				<source/>
				<target>Der aktuell verwendete Komprimierungsanbieter.</target>
			</trans-unit>
			<trans-unit id="report.statistics">
				<source/>
				<target>Komprimierungsstatistik</target>
			</trans-unit>
			<trans-unit id="report.original">
				<source/>
				<target>Original-Dateien</target>
			</trans-unit>
			<trans-unit id="report.processed">
				<source/>
				<target>Verarbeitete Dateien</target>
			</trans-unit>
			<trans-unit id="report.compressed">
				<source/>
				<target>Komprimiert</target>
			</trans-unit>
			<trans-unit id="report.not_compressed">
				<source/>
				<target>Nicht komprimiert</target>
			</trans-unit>
			<trans-unit id="report.errors">
				<source/>
				<target>Fehler</target>
			</trans-unit>
			<trans-unit id="report.errors.message">
				<source/>
				<target>Einige Bilder konnten nicht komprimiert werden. Details in der Dateiliste prüfen.</target>
			</trans-unit>
			<trans-unit id="report.api_usage">
				<source/>
				<target>API-Nutzung</target>
			</trans-unit>
			<trans-unit id="report.api_usage.description">
				<source/>
				<target>TinyPNG API Komprimierungszähler für diesen Monat. &lt;a href="https://tinify.com/dashboard/api" target="_blank" rel="noopener"&gt;Dashboard öffnen&lt;/a&gt;</target>
			</trans-unit>
			<trans-unit id="report.bytes_saved">
				<source/>
				<target>Eingesparter Speicherplatz</target>
			</trans-unit>
			<trans-unit id="report.bytes_saved.description">
				<source/>
				<target>Insgesamt eingesparter Speicherplatz über alle erfolgreich komprimierten Dateien.</target>
			</trans-unit>
			<trans-unit id="compress_provider">
				<source/>
				<target>Komprimierungsanbieter</target>
			</trans-unit>
			<trans-unit id="compress_tool">
				<source/>
				<target>Komprimierungswerkzeug</target>
			</trans-unit>
			<trans-unit id="compress_original_size">
				<source/>
				<target>Originalgröße (Bytes)</target>
			</trans-unit>
			<trans-unit id="compress_size">
				<source/>
				<target>Komprimierte Größe (Bytes)</target>
			</trans-unit>
			<trans-unit id="compress_tstamp">
				<source/>
				<target>Komprimiert am</target>
			</trans-unit>
			<trans-unit id="upgradeWizard.compressionColumns.title">
				<source/>
				<target>Strukturierte Komprimierungsspalten für bereits komprimierte Dateien zurücksetzen</target>
			</trans-unit>
			<trans-unit id="upgradeWizard.compressionColumns.description">
				<source/>
				<target>Frühere Versionen dieser Extension speicherten das Komprimierungsergebnis als einzelnen formatierten String (compress_info). Diese Spalte wurde durch strukturierte Spalten ersetzt (Anbieter, Werkzeug, Originalgröße, komprimierte Größe, Zeitstempel). Die alten Strings werden nicht nachträglich geparst; dieser Assistent setzt die neuen Spalten für bereits als komprimiert markierte Dateien auf "unbekannt" zurück, das compressed-Flag selbst bleibt unverändert.</target>
			</trans-unit>
		</body>
	</file>
</xliff>
