parameters:
	ignoreErrors:
		# Tinify's Exception::create() builds AccountException/ClientException/ServerException
		# dynamically from a class-name string inside Client::request(), so PHPStan cannot trace
		# that AccountException specifically can propagate out of Tinify\validate(); it genuinely
		# does at runtime on an invalid key or exhausted quota (see GH-50).
		-
			message: '#Dead catch - Tinify\\AccountException is never thrown in the try block#'
			path: ../../Classes/Compression/TinifyCompressor.php
		# Same root cause as above: Client::request() also raises ConnectionException/ServerException
		# for network failures and 5xx responses, but PHPStan cannot see through Tinify::getClient()'s
		# untyped return value to trace the call into Client::request() at all, so neither exception is
		# recognised as reachable through Tinify\validate(), even though both genuinely propagate at runtime.
		-
			message: '#Dead catch - Tinify\\ServerException is never thrown in the try block#'
			path: ../../Classes/Compression/TinifyCompressor.php
		-
			message: '#Dead catch - Tinify\\ConnectionException is never thrown in the try block#'
			path: ../../Classes/Compression/TinifyCompressor.php
		# Tests verify runtime behavior, PHPStan knows types at analysis time
		-
			message: '#Call to static method .+::assert.+ will always evaluate to true#'
			path: ../../Tests/Unit/Compression/ToolDetectionTest.php
		-
			message: '#Call to static method .+::assert.+ will always evaluate to true#'
			path: ../../Tests/Unit/Compression/TinifyCompressorTest.php
		# Extbase Repository does not require parent constructor call in TYPO3 v12+
		-
			message: '#does not call parent constructor from TYPO3\\CMS\\Extbase\\Persistence\\Repository#'
			path: ../../Classes/Domain/Repository/FileRepository.php
		# Version-specific view classes: StandaloneView for v12, ViewFactoryInterface for v13+
		# These classes exist in different TYPO3 versions, so errors may not always be present
		-
			message: '#Class TYPO3\\CMS\\Fluid\\View\\StandaloneView not found#'
			path: ../../Classes/Utility/ViewUtility.php
			reportUnmatched: false
		-
			message: '#Call to method .+ on an unknown class TYPO3\\CMS\\Fluid\\View\\StandaloneView#'
			path: ../../Classes/Utility/ViewUtility.php
			reportUnmatched: false
		-
			message: '#class TYPO3\\CMS\\Core\\View\\ViewFactoryData not found#i'
			path: ../../Classes/Utility/ViewUtility.php
			reportUnmatched: false
		-
			message: '#Class TYPO3\\CMS\\Core\\View\\ViewFactoryInterface not found#'
			path: ../../Classes/Utility/ViewUtility.php
			reportUnmatched: false
		-
			message: '#Call to method .+ on an unknown class TYPO3\\CMS\\Core\\View\\ViewFactoryInterface#'
			path: ../../Classes/Utility/ViewUtility.php
			reportUnmatched: false
		# ComponentGroup and the 4-argument ProcessFileListActionsEvent constructor are TYPO3 v14-only,
		# not part of the pinned v12 API this is analysed against
		-
			message: '#Instantiated class TYPO3\\CMS\\Backend\\Template\\Components\\ComponentGroup not found#'
			path: ../../Tests/Unit/EventListener/AfterFileListRenderedTest.php
			reportUnmatched: false
		-
			message: '#Class TYPO3\\CMS\\Filelist\\Event\\ProcessFileListActionsEvent constructor invoked with 4 parameters, 2 required#'
			path: ../../Tests/Unit/EventListener/AfterFileListRenderedTest.php
			reportUnmatched: false
		-
			message: '#Parameter \#1 \$fileOrFolder of class TYPO3\\CMS\\Filelist\\Event\\ProcessFileListActionsEvent constructor expects TYPO3\\CMS\\Core\\Resource\\ResourceInterface, TYPO3\\CMS\\Backend\\Template\\Components\\ComponentGroup given#'
			path: ../../Tests/Unit/EventListener/AfterFileListRenderedTest.php
			reportUnmatched: false
		-
			message: '#Parameter \#2 \$actionItems of class TYPO3\\CMS\\Filelist\\Event\\ProcessFileListActionsEvent constructor expects array, TYPO3\\CMS\\Backend\\Template\\Components\\ComponentGroup given#'
			path: ../../Tests/Unit/EventListener/AfterFileListRenderedTest.php
			reportUnmatched: false
		# Symfony Command's own constructor signature requires this default
		-
			message: '#Constructor .+CompressImageCommand has parameter \$name with default value#'
			path: ../../Classes/Command/CompressImageCommand.php
		# Named booleans/int disambiguate this private test helper's call sites; positional args would be unclear
		-
			message: '#Method .+CompressImageCommandTest::invokeExecute\(\) is invoked with named argument#'
			path: ../../Tests/Unit/Command/CompressImageCommandTest.php
		# TYPO3 v14 restructured ProcessFileListActionsEvent without getActionItems()/setActionItems();
		# the method_exists() guard is intentionally defensive for that version, PHPStan only sees v12 here
		-
			message: '#Call to function method_exists\(\) with TYPO3\\CMS\\Filelist\\Event\\ProcessFileListActionsEvent and ''getActionItems'' will always evaluate to true#'
			path: ../../Classes/EventListener/AfterFileListRendered.php
		-
			message: '#Call to function method_exists\(\) with TYPO3\\CMS\\Filelist\\Event\\ProcessFileListActionsEvent and ''setActionItems'' will always evaluate to true#'
			path: ../../Classes/EventListener/AfterFileListRendered.php
		# Not a hashing decision of ours: must reproduce IconFactory::getIcon()'s
		# own v12.4 cache-key algorithm exactly, or the pre-seeded entry is never found
		-
			message: '#Calling md5\(\) is forbidden#'
			path: ../../Tests/Unit/EventListener/IconFactoryTestDoubleFactory.php
		# FrontendInterface::set()'s own $tags parameter has no generic value type in
		# its declaring interface either; adding one here would violate contravariance
		-
			message: '#Method .+set\(\) has parameter \$tags with no value type specified in iterable type array#'
			path: ../../Tests/Unit/EventListener/IconFactoryTestDoubleFactory.php
		# Three independent, small review-driven fixes (--storage validation, a
		# Compressed-only cleanup guard, and accurate processed-file outcome
		# counting) each add a small amount of unavoidable branching to an
		# already-large command class. Splitting it into collaborator classes to
		# stay under the budget is a larger refactor than any one of these fixes
		# warrants on its own.
		-
			message: '#Class cognitive complexity is \d+, keep it under 40#'
			path: ../../Classes/Command/CompressImageCommand.php
		# Skipping non-local storages is a small, necessary guard clause; the
		# rest of the compress-and-report flow this sits alongside already
		# carries the file's natural complexity budget.
		-
			message: '#Class cognitive complexity is \d+, keep it under 40#'
			path: ../../Classes/Compression/TinifyCompressor.php
		-
			message: '#Cognitive complexity for .+::compress\(\)" is \d+, keep it under 10#'
			path: ../../Classes/Compression/LocalBasicCompressor.php
